// このファイルを arduino_secrets.h にコピーして、自分の環境の値を書く。
// arduino_secrets.h は .gitignore 済み (パスワードをコミットしないため)。
#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// 2 つ目の Wi-Fi (任意)。外で使うスマホのテザリングなど。つながらないときに 1 つ目と交互に試す
// #define WIFI_SSID2 "your-phone-hotspot"
// #define WIFI_PASS2 "your-hotspot-password"

// Discord の中継。tools/discord_relay.py を tailscale funnel で公開した名前と、決めておいた合言葉。
// 中継を起動すると、そのまま書ける行を表示する。書かなければ Discord は使わない
#define RELAY_HOST "dynabook.tailxxxx.ts.net"
#define RELAY_PORT 8443   // 今は使っていない。Discord の流れも 10000 番につなぐ (GPS の位置を同じ接続で送るため)
#define RELAY_KEY  "your-relay-key"

// 予備の入口 (任意)。別の PC で tools/relay_gateway.py を動かし、Funnel で公開した名前。
// RELAY_HOST につなげないときに試す。書かなければ使わない
// #define RELAY_HOST2 "ubuntubook.tailxxxx.ts.net"
