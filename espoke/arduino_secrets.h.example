// このファイルを arduino_secrets.h にコピーして、自分の環境の値を書く。
// arduino_secrets.h は .gitignore 済み (パスワードをコミットしないため)。
#pragma once

#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// Discord の中継。tools/discord_relay.py を tailscale funnel で公開した名前と、決めておいた合言葉。
// 中継を起動すると、そのまま書ける行を表示する。書かなければ Discord は使わない
#define RELAY_HOST "dynabook.tailxxxx.ts.net"
#define RELAY_PORT 8443
#define RELAY_KEY  "your-relay-key"
